# Server (copy to apps/server/.env for local dev; docker-compose reads this file from the repo root)
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:3000
EVENT_REPLAY_LIMIT=500
LOG_LEVEL=info

# Web (defaults to http://localhost:4000 if unset)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
